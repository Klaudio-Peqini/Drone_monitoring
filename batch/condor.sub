# Submit from the directory containing the ZIP and extracted project:
# mkdir -p logs
# condor_submit Drone_Airflow_3D/batch/condor.sub
universe = vanilla
executable = Drone_Airflow_3D/batch/run_condor.sh
arguments = job_$(ClusterId)_$(ProcId)
request_cpus = 4
request_memory = 4GB
request_disk = 1GB
should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_input_files = Drone_Airflow_3D.zip
transfer_output_files = job_$(ClusterId)_$(ProcId)
# Replace CFD_PYTHON with your shared installed Python environment if needed.
environment = "CFD_CPU_LIMIT=4"
output = logs/placement_$(ClusterId)_$(ProcId).out
error = logs/placement_$(ClusterId)_$(ProcId).err
log = logs/placement_$(ClusterId)_$(ProcId).log
# On CERN Batch, select a suitable JobFlavour for your measured wall time.
queue 1
