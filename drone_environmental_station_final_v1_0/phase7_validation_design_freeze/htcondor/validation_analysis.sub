universe = vanilla
executable = /usr/bin/bash
arguments = -lc "cd $(InitialDir) && source .venv/bin/activate && python scripts/check_package.py"
initialdir = ..
output = logs/condor_check.$(ClusterId).$(ProcId).out
error  = logs/condor_check.$(ClusterId).$(ProcId).err
log    = logs/condor_check.$(ClusterId).log
request_cpus = 1
request_memory = 1G
request_disk = 1G
should_transfer_files = IF_NEEDED
when_to_transfer_output = ON_EXIT
queue 1
